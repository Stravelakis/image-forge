# Image Forge — environment variables.
#
# The desktop app and the browser app need NONE of these: keys are typed into
# Settings and stay on your machine. These are only for the agent server,
# scripts/mcp-server.js, when you run it without a settings backup file.
# Never commit real values. Copy to .env only if your MCP client reads one.

# Free engines
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
POLLINATIONS_TOKEN=

# Paid engines. The agent server REFUSES any row that would run on a paid engine
# unless FORGE_ALLOW_PAID=1 is set below, and then stops at FORGE_MAX_USD in total.
# Keep these keys out unless you want an agent able to spend.
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_IMAGE_MODEL=
OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL=

# Your own machine (LocalAI, ComfyUI, LM Studio…)
FORGE_LOCAL_BASE=
FORGE_LOCAL_MODEL=
FORGE_LOCAL_KEY=

# Force an engine: ovh | cloudflare | pollinations | gemini | openai | local
FORGE_PROVIDER=

# Money limits for the agent server (off by default: paid engines are refused)
# FORGE_ALLOW_PAID=1 lets rows run on paid engines; leave empty to refuse them.
# FORGE_MAX_USD is the most the server may spend in total; 1 if allowed and empty.
FORGE_ALLOW_PAID=
FORGE_MAX_USD=
